# TravelBuddy frontend - copy to .env.local

# The Express API (travelbuddy/server).
NEXT_PUBLIC_API_URL=http://localhost:5002/api

# NextAuth - required, or the app shows a configuration error.
#   AUTH_SECRET:  openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Optional: "Continue with Google". Add http://localhost:3000/api/auth/callback/google
# as an authorised redirect URI in Google Cloud Console. Email sign-up works
# without it (accounts live in your local MongoDB).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Street View and map embeds
# (Maps JavaScript API, Places API, Street View Static API).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
