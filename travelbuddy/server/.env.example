# TravelBuddy API - copy to .env

PORT=5002
# MongoDB must be reachable or the server stops. Local:  mongod
# or Docker:  docker run -d -p 27017:27017 mongo     or a free MongoDB Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27017/travelbuddy

# ── Live hotels and flights (the core of the app) ──────────────────────────
# serpapi.com - the free plan is 250 searches a month. One destination costs
# three (hotels, outbound flights, return flights). With no key the app runs in
# Demo Mode on saved real responses and labels them "SAVED EXAMPLE".
SERPAPI_API_KEY=
# Credit caps per IST day / month (defaults 40 / 230).
SERPAPI_DAILY_CAP=
SERPAPI_MONTHLY_CAP=

# ── Optional: AI-written itineraries, the chat assistant, photo analysis ───
# Gemini through Vertex AI. Without these the server still starts and the
# seed itineraries are used.
VERTEX_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=
